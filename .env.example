# Copy to .env (gitignored) and fill in.
ANTHROPIC_API_KEY=

# Optional overrides
# NEGOTRAIN_MODEL=claude-opus-5-5
# NEGOTRAIN_EFFORT=medium          # low | medium | high | xhigh | max
# NEGOTRAIN_SESSIONS_DIR=data/sessions

# System-prefix cache lifetime. 5m refreshes on hits; 1h costs more per write.
# NEGOTRAIN_CACHE_TTL=5m           # 5m | 1h
